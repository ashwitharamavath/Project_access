pipeline {
    agent {
        label 'win'   // Runs on your Windows agent
    }

    options {
        skipDefaultCheckout(true)   // We’ll handle checkout manually
    }

    environment {
        PROJECT_NAME = "Project_access"
    }

    stages {

        stage('Checkout') {
            steps {
                echo "📦 Cloning GitHub repository..."
                checkout([
                    $class: 'GitSCM',
                    branches: [[name: '*/main']],
                    userRemoteConfigs: [[url: 'https://github.com/Pratima2705/Project_access.git']]
                ])
            }
        }

        stage('Validate and Build') {
            parallel {

                stage('Validate Files') {
                    steps {
                        echo "🧾 Checking for essential project files..."
                        bat '''
                        if exist index.html (
                            echo index.html found.
                        ) else (
                            echo ⚠️ index.html missing!
                        )

                        if exist faculty.html (
                            echo faculty.html found.
                        ) else (
                            echo ⚠️ faculty.html missing!
                        )
                        '''
                    }
                }

                stage('Build') {
                    steps {
                        echo "🏗️ Preparing static site build (if needed)..."
                        bat '''
                        echo No compilation required for static HTML/CSS project.
                        echo Skipping build step.
                        '''
                    }
                }
            }
        }

        stage('Archive Artifacts') {
            steps {
                echo "📂 Archiving website files..."
                // Archive all HTML, CSS, JS, and image files if any
                archiveArtifacts artifacts: '**/*.html, **/*.css, **/*.js, **/*.png, **/*.jpg', fingerprint: true
            }
        }
    }

    post {
        success {
            echo "✅ Build succeeded! Website files archived successfully."
        }
        failure {
            echo "❌ Build failed — please check console output."
        }
    }
}
